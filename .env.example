# Ruta base del build: / para Firebase | /FabioBalanzas-Web/ para GitHub Pages
VITE_BASE_PATH=/

# Portal de clientes (botón "Portal clientes" en el header)
VITE_CLIENT_PORTAL_URL=https://portal.fabiobalanzas.com.ar

# Sitio corporativo en producción (opcional; por defecto www.fabiobalanzas.com.ar)
# VITE_SITE_URL=https://www.fabiobalanzas.com.ar

# Formulario de contacto — ver docs/CONTACTO-FORMULARIO.md
VITE_CONTACT_SUBMIT_URL=https://portal.fabiobalanzas.com.ar/api/demo-request
